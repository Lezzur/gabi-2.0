{
  "expo": {
    "name": "Gaia",
    "slug": "gaia",
    "scheme": "gaia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5EDD8"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gaia.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Gaia needs camera access to scan QR codes on fertilizer bags."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F5EDD8"
      },
      "package": "com.gaia.mobile",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Gaia needs camera access to scan QR codes on fertilizer bags."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
