# Test environment — safe to commit (points to local/test infrastructure only)
# For local secret overrides, use .env.test.local (gitignored)

# Supabase local dev (supabase start)
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=your-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key

# Separate Supabase test project for Playwright E2E
SUPABASE_URL_TEST=http://localhost:54321
SUPABASE_ANON_KEY_TEST=your-test-anon-key
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-test-anon-key

# App base URLs
BASE_URL=http://localhost:3001

# Scan API
HMAC_SECRET=test-hmac-secret-32-chars-minimum

# OCR
OCR_PROVIDER=gemini
GEMINI_API_KEY=test-key
ANTHROPIC_API_KEY=test-key

# SMS (mocked in tests)
TWILIO_ACCOUNT_SID=ACtest
TWILIO_AUTH_TOKEN=test-token
SMS_FALLBACK_PROVIDER=
